NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=loakinaja
DB_USER=root
DB_PASSWORD=
DB_LOG_SQL=false

# Generate a long random secret, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Cloudflare R2 S3-compatible credentials
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public custom domain or R2.dev URL, e.g. https://images.example.com
R2_PUBLIC_BASE_URL=
