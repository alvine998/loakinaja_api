NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# Google OAuth web application credentials. Add
# ${API_PUBLIC_URL}/api/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=loakinaja
DB_USER=root
DB_PASSWORD=
DB_LOG_SQL=false

# Generate a long random secret, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Mayar Headless API V2 (use the sandbox API key with the sandbox URL)
MAYAR_API_KEY=
MAYAR_BASE_URL=https://api.mayar.id/hl/v2
# Sandbox: https://api.mayar.io/hl/v2

# Digiflazz Buyer API (credentials from Digiflazz API connection settings)
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
DIGIFLAZZ_BASE_URL=https://api.digiflazz.com/v1
DIGIFLAZZ_TESTING=false
# Configure the same secret in Digiflazz webhook settings
DIGIFLAZZ_WEBHOOK_SECRET=
# Retail markup added to the Digiflazz price (Rupiah)
PPOB_MARKUP_RUPIAH=1000

# Initial admin credentials used by `npm run seed` (use a unique, strong password).
# Admin login thereafter reads the bcrypt hash stored in the admins table.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Cloudflare R2 S3-compatible credentials
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public custom domain or R2.dev URL, e.g. https://images.example.com
R2_PUBLIC_BASE_URL=
